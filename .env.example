# Copy to .env and fill in. Never commit the filled-in file.
#
#   cp .env.example .env
#
# Everything here is read through a Zod-validated loader at boot
# (backend/src/config/env.ts). A missing or malformed value fails the
# process immediately with a readable message rather than surfacing as an
# undefined at request time.
#
# The file is loaded by `npm run dev`, `npm run start`, `npm run db:apply` and
# `npm run db:reset`. A real environment variable always wins over the value
# here, so CI and the hosting dashboard stay authoritative and this file only
# fills the gaps. Test runs ignore it entirely, so a local database
# configuration cannot quietly change what the suites assert.


# ─── Backend ────────────────────────────────────────────────────────────────

# Port the local API listens on. Vercel supplies its own in production.
PORT=3000

# development | test | production
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
# Production value is the deployed frontend URL, set in Vercel.
CORS_ORIGIN=http://localhost:5173

# Requests per caller per minute, across the whole API. A courtesy limit that
# stops a runaway client, not a security control — each serverless instance
# counts only what it serves. See backend/src/middleware/rate-limit.ts.
RATE_LIMIT_PER_MINUTE=120

# Whether x-forwarded-for identifies the caller.
#
# Leave false unless a proxy you control overwrites the header on every request.
# Anywhere else it is caller-supplied, and believing it lets one client claim a
# fresh rate-limit budget per request simply by inventing a new value. Vercel
# does overwrite it, so set this to true there and nowhere else.
TRUST_PROXY=false

# Which persistence adapter to use.
#   memory    — in-memory repository, no database required (v1 default)
#   postgres  — Drizzle over Supabase Postgres, requires DATABASE_URL
#
# NODE_ENV=production refuses to boot on "memory": the store lives inside one
# serverless instance, so writes vanish at the next cold start and are invisible
# to every sibling instance in the meantime. Silent data loss is worse than a
# failed deploy, so the env loader turns it into the latter.
DATA_SOURCE=memory

# Supabase Postgres connection string. Only needed when DATA_SOURCE=postgres.
# Supabase dashboard → Project Settings → Database → Connection string (URI).
# Use the pooled connection (port 6543) for serverless deployments.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres


# ─── AI (optional) ──────────────────────────────────────────────────────────
#
# Leave these unset and the app still works completely: the coach endpoints
# return 503 and the AI surfaces hide themselves in the UI. Every requirement
# in the assessment brief is met without a key.
#
# This key is read on the backend only. It is never sent to the browser.
# Get one at https://aistudio.google.com/apikey

# GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Ceiling on AI requests per IP per minute.
AI_RATE_LIMIT_PER_MINUTE=10


# ─── Frontend ───────────────────────────────────────────────────────────────
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Treat every VITE_ value as public. Never put a secret behind this prefix.

VITE_API_BASE_URL=http://localhost:3000
