{
  "name": "@crema/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Crema JSON API",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:ai": "vitest run --config vitest.ai.config.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.44",
    "@crema/shared": "^0.1.0",
    "@hono/node-server": "^2.1.1",
    "ai": "^7.0.65",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12"
  }
}
